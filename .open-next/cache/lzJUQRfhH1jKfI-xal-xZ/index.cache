{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"id\" data-theme=\"entrosync\" class=\"inter_fe8b9d92-module__LINzvG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/favicon.svg\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/44pxtcnw1spdy.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1bofez1h07ns8.js\"/><script src=\"/_next/static/chunks/3onx57x5q00_y.js\" async=\"\"></script><script src=\"/_next/static/chunks/1m4y8hvx1de05.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-339zh2vhdk86u.js\" async=\"\"></script><script src=\"/_next/static/chunks/0pr6g23k3kqn-.js\" async=\"\"></script><script src=\"/_next/static/chunks/3krum7tl491tk.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ehwvjh3sx43.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>EntroSync | Portal Klien untuk Freelancer dan Agensi</title><meta name=\"description\" content=\"EntroSync membantu freelancer dan agensi mengubah chat klien menjadi brief AI, milestone, portal klien tanpa login, dan invoice dalam satu workspace.\"/><link rel=\"canonical\" href=\"/\"/><link rel=\"alternate\" hrefLang=\"id-ID\" href=\"/\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"/en\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-inter bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-base-100 text-base-content\"><header class=\"sticky top-0 z-50 border-b border-base-300 bg-base-100/95 backdrop-blur\"><nav class=\"navbar mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"navbar-start\"><div class=\"dropdown\"><button aria-label=\"Buka menu navigasi\" class=\"btn btn-ghost btn-square lg:hidden\" tabindex=\"0\" type=\"button\"><svg aria-hidden=\"true\" class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 6h16M4 12h16M4 18h16\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg></button><ul class=\"menu dropdown-content menu-sm z-50 mt-3 w-52 rounded-lg border border-base-300 bg-base-100 p-2 shadow\" tabindex=\"0\"><li><a href=\"#solutions\">Solusi</a></li><li><a href=\"#playground\">Playground</a></li><li><a href=\"#demo\">Demo</a></li><li><a href=\"#proof\">Bukti</a></li><li><a href=\"#faq\">FAQ</a></li></ul></div><a class=\"flex items-center gap-2\" href=\"/\" aria-label=\"Beranda EntroSync\"><img alt=\"EntroSync logo\" width=\"32\" height=\"32\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/favicon.svg\"/><span class=\"text-xl font-bold\">EntroSync</span></a></div><div class=\"navbar-center hidden lg:flex\"><ul class=\"menu menu-horizontal gap-1 px-1\"><li><a href=\"#solutions\">Solusi</a></li><li><a href=\"#playground\">Playground</a></li><li><a href=\"#demo\">Demo</a></li><li><a href=\"#proof\">Bukti</a></li><li><a href=\"#faq\">FAQ</a></li></ul></div><div class=\"navbar-end gap-2\"><div aria-label=\"Ganti bahasa\" class=\"join border border-base-300 bg-base-200 p-0.5\" role=\"group\"><button aria-pressed=\"true\" class=\"btn join-item btn-xs rounded-full px-3 btn-primary\" type=\"button\">ID</button><button aria-pressed=\"false\" class=\"btn join-item btn-xs rounded-full px-3 btn-ghost\" type=\"button\">EN</button></div><a class=\"btn btn-ghost hidden rounded-full sm:inline-flex\" href=\"#demo\">Lihat demo</a><a class=\"btn btn-primary rounded-full\" href=\"#cta\">Coba EntroSync</a></div></nav></header><section class=\"relative overflow-hidden border-b border-base-300 bg-base-100\"><div class=\"mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_0.95fr] lg:px-8 lg:py-24\"><div class=\"flex flex-col justify-center\"><div class=\"badge badge-outline mb-6 gap-2 border-primary/40 px-4 py-3 text-primary\">EntroSync - Portal Klien untuk Freelancer dan Agensi</div><h1 class=\"max-w-3xl text-4xl font-bold leading-tight tracking-normal sm:text-5xl lg:text-6xl\">Portal klien all-in-one untuk freelancer dan agensi.</h1><p class=\"mt-6 max-w-2xl text-lg leading-8 text-base-content/70\">Ubah chat klien yang berantakan menjadi proposal AI, bagikan magic link tanpa login, pantau milestone secara real time, dan buat invoice dalam satu workspace yang rapi.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"btn btn-primary rounded-full px-7\" href=\"#cta\">Coba EntroSync</a><a class=\"btn btn-outline rounded-full px-7\" href=\"#demo\">Lihat demo</a></div><div class=\"mt-8 grid max-w-xl grid-cols-1 gap-3 text-sm sm:grid-cols-3\"><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">✨ Brief AI Otomatis</div><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">🔗 Magic Link Tanpa Login</div><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">⚡ Invoice Sekali Klik</div></div></div><div class=\"rounded-xl border border-base-300 bg-base-100 p-4 shadow-xl\"><div class=\"mb-4 flex items-center justify-between gap-3 border-b border-base-300 pb-4\"><div><p class=\"text-sm font-semibold\">Studio Ops Automation</p><p class=\"text-xs text-base-content/60\">Portal Klien: /client/47b5f060...</p></div><span class=\"badge badge-success badge-outline whitespace-nowrap\">Berjalan</span></div><div class=\"grid gap-3 sm:grid-cols-3\"><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Progress Proyek</p><p class=\"mt-2 text-lg font-bold\">64%</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Milestone</p><p class=\"mt-2 text-lg font-bold\">2 dari 3 Selesai</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Link Portal Klien</p><p class=\"mt-2 text-lg font-bold\">Aktif</p></div></div><div class=\"mt-4 space-y-3\"><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Discovery &amp; Konfirmasi Scope</p><p class=\"text-sm text-base-content/60\">1 Agustus 2026</p></div><span class=\"badge whitespace-nowrap badge-success\">Selesai</span></div><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Design System &amp; Wireframe</p><p class=\"text-sm text-base-content/60\">15 Agustus 2026</p></div><span class=\"badge whitespace-nowrap badge-primary\">Berjalan</span></div><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Integrasi Backend &amp; Portal Klien</p><p class=\"text-sm text-base-content/60\">4 September 2026</p></div><span class=\"badge whitespace-nowrap badge-neutral\">Belum Mulai</span></div></div></div></div></section><section id=\"playground\" class=\"border-b border-base-300 bg-base-100 py-20\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"text-center\"><div class=\"badge badge-primary badge-outline mb-4 px-4 py-3\">Interactive Playground</div><h2 class=\"text-3xl font-bold sm:text-4xl\">Coba alur kerja EntroSync secara langsung.</h2><p class=\"mx-auto mt-3 max-w-2xl text-base-content/70\">Lihat bagaimana AI mengubah chat klien mentah menjadi milestone terstruktur, atau pratinjau portal yang dilihat klien lewat magic link tanpa login.</p></div><div class=\"mt-10 flex justify-center\"><div class=\"inline-flex max-w-full flex-col gap-1.5 rounded-3xl border border-base-300 bg-base-200 p-1.5 shadow-sm sm:flex-row sm:rounded-full\"><button class=\"flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition bg-primary text-primary-content shadow\" type=\"button\"><span>✨</span><span>1. Smart AI Brief Generator</span></button><button class=\"flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition text-base-content/70 hover:text-base-content\" type=\"button\"><span>🔗</span><span>2. Portal Magic Link Klien (/client/:token)</span></button></div></div><div class=\"mt-10 grid gap-8 lg:grid-cols-2\"><div class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-md\"><div><div class=\"mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\"><span class=\"text-xs font-semibold uppercase tracking-wider text-base-content/60\">Input Chat / Email Klien Mentah</span><div class=\"flex gap-2\"><button class=\"btn btn-xs rounded-full btn-primary\" type=\"button\">Contoh<!-- --> <!-- -->1</button><button class=\"btn btn-xs rounded-full btn-ghost\" type=\"button\">Contoh<!-- --> <!-- -->2</button></div></div><textarea class=\"textarea textarea-bordered h-44 w-full bg-base-200 font-mono text-sm leading-relaxed text-base-content focus:outline-none\" placeholder=\"Tempel riwayat WhatsApp, catatan email, atau transkrip call di sini...\">Klien: &quot;Halo! Kami butuh rebrand penuh untuk toko online. Logo baru, redesign homepage, perbaikan filter produk, dan integrasi payment gateway. Target launch 1 September. Budget sekitar Rp 60 juta.&quot;</textarea></div><div class=\"mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\"><span class=\"text-xs text-base-content/60\">Memakai contoh: Chat Rebrand E-Commerce</span><button class=\"btn btn-primary rounded-full px-6\" type=\"button\">✨ Buat SOW &amp; Milestone AI</button></div></div><div class=\"rounded-xl border border-base-300 bg-base-200 p-6 shadow-md\"><div class=\"mb-4 flex flex-col gap-2 border-b border-base-300 pb-3 sm:flex-row sm:items-center sm:justify-between\"><div class=\"flex items-center gap-2\"><span class=\"badge badge-success badge-xs\"></span><span class=\"text-xs font-semibold uppercase tracking-wider text-base-content/70\">PRD &amp; Scope of Work Hasil AI</span></div><span class=\"badge badge-outline text-xs\">Siap Diadopsi Sekali Klik</span></div><div class=\"space-y-4\"><div><h4 class=\"text-lg font-bold text-primary\">Rebrand &amp; Optimasi Toko E-Commerce</h4><p class=\"mt-1 text-xs leading-relaxed text-base-content/70\">Rebrand visual, redesign UI/UX homepage, perbaikan filter katalog, dan setup payment gateway.</p></div><div class=\"space-y-2.5\"><p class=\"text-xs font-semibold text-base-content/60\">Milestone Terdeteksi:</p><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">Brand Identity &amp; Design System</p><p class=\"text-xs text-base-content/60\">4<!-- --> <!-- -->tugas<!-- --> • <!-- -->Target:<!-- --> <!-- -->10 Agu 2026</p></div><span class=\"badge badge-sm badge-success\">Selesai</span></div><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">UI Homepage &amp; Filter Produk</p><p class=\"text-xs text-base-content/60\">6<!-- --> <!-- -->tugas<!-- --> • <!-- -->Target:<!-- --> <!-- -->22 Agu 2026</p></div><span class=\"badge badge-sm badge-primary\">Berjalan</span></div><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">Payment Gateway &amp; QA Launch</p><p class=\"text-xs text-base-content/60\">3<!-- --> <!-- -->tugas<!-- --> • <!-- -->Target:<!-- --> <!-- -->1 Sep 2026</p></div><span class=\"badge badge-sm badge-neutral\">Belum Mulai</span></div></div><div class=\"mt-4 flex justify-end\"><button class=\"btn btn-outline btn-sm rounded-full\" type=\"button\">🔗 Pratinjau Portal Magic Link Klien</button></div></div></div></div></div></section><section id=\"solutions\" class=\"mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"max-w-2xl\"><p class=\"font-semibold text-primary\">Fitur Inti Platform</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Semua yang freelancer butuhkan untuk mengelola klien dengan jelas.</h2><p class=\"mt-4 text-base-content/70\">Kurangi gesekan komunikasi, hemat jam kerja administratif, dan berikan klien visibilitas progress yang rapi.</p></div><div class=\"mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4\"><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">✨</div><h3 class=\"text-xl font-semibold\">Smart AI Brief Generator</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Tempel chat WhatsApp, email, atau catatan call. AI langsung membuat PRD, scope of work, dan milestone proyek sekali klik.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">🔗</div><h3 class=\"text-xl font-semibold\">Portal Klien Tanpa Login</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Bagikan magic link unik (/client/:token). Klien langsung melihat progress, dokumen, dan invoice tanpa harus membuat akun.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">📊</div><h3 class=\"text-xl font-semibold\">Progress Tracker Transparan</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Pecah proyek menjadi milestone jelas. Saat pekerjaan ditandai selesai, progress bar klien ikut terbarui otomatis.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">⚡</div><h3 class=\"text-xl font-semibold\">Invoice &amp; PDF Sekali Klik</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Buat invoice profesional dari milestone selesai. Klien bisa melihat status pembayaran dan mengunduh PDF dari portal.</p></div></article></div></section><section id=\"demo\" class=\"border-y border-base-300 bg-base-100 py-20\"><div class=\"mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:px-8\"><div class=\"flex flex-col justify-center\"><p class=\"font-semibold text-primary\">Product Showcase</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Lihat kondisi proyek sebelum jadi meeting tambahan.</h2><p class=\"mt-4 leading-7 text-base-content/70\">Tonton bagaimana EntroSync menyatukan proyek klien, milestone, akses magic link, dan invoicing real time dalam satu workspace.</p><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"badge badge-lg\">Dashboard</span><span class=\"badge badge-lg\">Portal Klien</span><span class=\"badge badge-lg\">Milestone</span><span class=\"badge badge-lg\">Invoice</span></div></div><div class=\"overflow-hidden rounded-xl border border-base-300 bg-base-200 shadow-2xl\"><div class=\"flex items-center justify-between border-b border-base-300 bg-base-300/40 px-4 py-3\"><div class=\"flex items-center gap-2\"><span class=\"inline-block h-3 w-3 rounded-full bg-red-500/80\"></span><span class=\"inline-block h-3 w-3 rounded-full bg-yellow-500/80\"></span><span class=\"inline-block h-3 w-3 rounded-full bg-green-500/80\"></span></div><span class=\"text-xs font-medium text-base-content/60\">EntroSync - Walkthrough Demo Produk</span><div class=\"w-12\"></div></div><div class=\"relative aspect-video w-full bg-black\"><video autoPlay=\"\" controls=\"\" loop=\"\" muted=\"\" playsInline=\"\" preload=\"metadata\" class=\"h-full w-full object-cover\" src=\"/product-demo.mp4\"><track kind=\"captions\"/>Browser Anda tidak mendukung video.</video></div></div></div></section><section id=\"proof\" class=\"mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"grid gap-8 lg:grid-cols-[0.75fr_1fr]\"><div><p class=\"font-semibold text-primary\">Dipercaya Freelancer</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Dibuat untuk hubungan klien yang lebih transparan.</h2><div class=\"mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3\"><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">100%</p><p class=\"mt-1 text-xs text-base-content/60\">Keamanan Read-Only</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">1 Klik</p><p class=\"mt-1 text-xs text-base-content/60\">Magic Invite</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">10x</p><p class=\"mt-1 text-xs text-base-content/60\">Proposal Lebih Cepat</p></div></div></div><div class=\"grid gap-4 md:grid-cols-3\"><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->EntroSync menghemat 5+ jam admin setiap minggu. Klien saya suka membuka satu magic link daripada bertanya update manual.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Alex Rivera</p><p class=\"text-xs text-base-content/60\">Full-Stack Freelancer</p></div></article><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->Fitur AI Brief terasa seperti magic. Saya tempel chat WhatsApp panjang, lalu EntroSync memberi PRD dan milestone dalam hitungan detik.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Maya Chen</p><p class=\"text-xs text-base-content/60\">Konsultan Design System</p></div></article><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->Invoice dulu selalu merepotkan. Sekarang klien bisa melihat dan mengunduh PDF invoice langsung dari portal proyek.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Marcus Vance</p><p class=\"text-xs text-base-content/60\">Founder Agensi</p></div></article></div></div></section><section id=\"why-us\" class=\"border-y border-base-300 bg-base-100 py-20\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><p class=\"font-semibold text-primary\">Kenapa EntroSync?</p><h2 class=\"mt-3 max-w-2xl text-3xl font-bold sm:text-4xl\">Ganti chaos klien yang tersebar dengan workspace yang terstruktur.</h2><div class=\"mt-10 overflow-hidden rounded-xl border border-base-300 bg-base-100 shadow-sm\"><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Workflow Terpencar</p><p class=\"mt-1 text-sm font-medium\">Chat WhatsApp, link Drive, dan dokumen Notion terpencar</p></div><div><p class=\"text-sm font-semibold text-primary\">Workspace EntroSync</p><p class=\"mt-1 text-sm font-medium\">Satu workspace terpadu untuk freelancer dan klien</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Sebelum</p><p class=\"mt-1 text-sm font-medium\">SOW dan proposal dibuat manual dari nol</p></div><div><p class=\"text-sm font-semibold text-primary\">Sesudah</p><p class=\"mt-1 text-sm font-medium\">PRD, scope of work, dan milestone dibuat AI</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Sebelum</p><p class=\"mt-1 text-sm font-medium\">Klien terus bertanya &#x27;sudah sampai mana?&#x27;</p></div><div><p class=\"text-sm font-semibold text-primary\">Sesudah</p><p class=\"mt-1 text-sm font-medium\">Progress bar read-only dan milestone real time</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Sebelum</p><p class=\"mt-1 text-sm font-medium\">Invoice Excel dan lampiran PDF terpisah</p></div><div><p class=\"text-sm font-semibold text-primary\">Sesudah</p><p class=\"mt-1 text-sm font-medium\">Invoice terintegrasi dengan status pembayaran dan export PDF</p></div></div></div></div></section><section id=\"cta\" class=\"mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"rounded-xl bg-neutral p-6 text-neutral-content shadow-xl sm:p-10\"><div class=\"grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center\"><div><p class=\"font-semibold text-neutral-content/80\">Early Access</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Upgrade pengalaman portal klien Anda hari ini.</h2><p class=\"mt-4 leading-7 text-neutral-content/70\">Masuk waitlist EntroSync untuk merapikan brief klien, tracking milestone, dan invoicing dalam satu workspace.</p></div><form class=\"flex flex-col gap-3\" action=\"#\"><label class=\"sr-only\" for=\"email\">Alamat email</label><input class=\"input input-bordered w-full bg-base-100 text-base-content\" id=\"email\" placeholder=\"freelancer@agency.com\" type=\"email\" name=\"email\"/><button class=\"btn btn-primary rounded-full\" type=\"submit\">Coba EntroSync</button><p class=\"text-xs text-neutral-content/60\">Tanpa spam. Jadi yang pertama mencoba EntroSync.</p></form></div></div></section><section id=\"faq\" class=\"mx-auto max-w-4xl px-4 pb-20 sm:px-6 lg:px-8\"><div class=\"text-center\"><p class=\"font-semibold text-primary\">Pertanyaan Umum</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Yang perlu Anda tahu tentang EntroSync.</h2></div><div class=\"mt-10 space-y-3\"><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Bagaimana klien mengakses portal proyek?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Freelancer membuat magic link unik (contoh: /client/:token) untuk setiap proyek. Klien cukup membuka link di desktop atau mobile tanpa registrasi, login, atau password.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Apakah portal klien aman dan read-only?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Ya. Portal klien dirancang read-only. Klien bisa melihat progress, milestone, task, dokumen, log, dan invoice, tetapi tidak bisa mengubah data proyek atau mengakses pengaturan freelancer.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Bagaimana fitur Smart AI Brief bekerja?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Tempel riwayat chat, email, atau catatan call ke EntroSync. AI menganalisis teks lalu membuat PRD, scope of work, dan rekomendasi milestone yang bisa Anda pakai sekali klik.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Apakah freelancer bisa membuat invoice dan export PDF?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Bisa. Anda dapat membuat invoice profesional berdasarkan milestone selesai atau item kustom, melacak status Pending/Paid, dan membiarkan klien mengunduh PDF dari portal.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Bisakah saya mengelola banyak proyek klien?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Bisa. Freelancer memiliki dashboard terpusat untuk mengelola semua proyek, memantau payout tertunda, dan membuat magic link untuk setiap akun aktif.</p></div></details></div></section><footer class=\"border-t border-base-300 bg-base-100 py-12 text-base-content/80\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"grid gap-8 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"space-y-3 lg:col-span-1\"><a class=\"flex items-center gap-2\" href=\"/\" aria-label=\"Beranda EntroSync\"><img alt=\"EntroSync logo\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/favicon.svg\"/><span class=\"text-xl font-bold text-base-content\">EntroSync</span></a><p class=\"text-xs leading-relaxed text-base-content/60\">Portal klien all-in-one untuk freelancer dan agensi. Ubah chat mentah menjadi brief AI, bagikan magic link, dan buat invoice sekali klik.</p></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Fitur Produk</p><ul class=\"mt-3 space-y-2 text-xs\"><li><a href=\"#solutions\" class=\"hover:text-primary transition\">Smart AI Brief</a></li><li><a href=\"#playground\" class=\"hover:text-primary transition\">Portal Klien Magic Link</a></li><li><a href=\"#demo\" class=\"hover:text-primary transition\">Demo Video Produk</a></li><li><a href=\"#solutions\" class=\"hover:text-primary transition\">Invoice &amp; Export PDF</a></li></ul></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Navigasi</p><ul class=\"mt-3 space-y-2 text-xs\"><li><a href=\"#why-us\" class=\"hover:text-primary transition\">Kenapa EntroSync?</a></li><li><a href=\"#proof\" class=\"hover:text-primary transition\">Bukti Freelancer &amp; Review</a></li><li><a href=\"#faq\" class=\"hover:text-primary transition\">Pertanyaan Umum</a></li><li><a href=\"#cta\" class=\"hover:text-primary transition\">Waitlist Early Access</a></li></ul></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Keamanan Portal Klien</p><div class=\"mt-3 rounded-lg border border-base-300 bg-base-200 p-3 text-xs text-base-content/70\"><p class=\"font-semibold text-primary\">100% Isolasi Read-Only</p><p class=\"mt-1 text-[11px] leading-relaxed\">Akses klien berbasis token (`/client/:token`) membantu klien memantau progress proyek tanpa bisa mengubah data workspace.</p></div></div></div><div class=\"mt-12 flex flex-col items-center justify-between border-t border-base-300/60 pt-6 text-xs text-base-content/50 sm:flex-row\"><p>© <!-- -->2026<!-- --> EntroSync. <!-- -->Hak cipta dilindungi.</p><div class=\"mt-3 flex gap-4 sm:mt-0\"><a href=\"#\" class=\"hover:text-base-content transition\">Privacy Policy</a><a href=\"#\" class=\"hover:text-base-content transition\">Terms of Service</a><a href=\"#\" class=\"hover:text-base-content transition\">Security Rules</a></div></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/1bofez1h07ns8.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[29113,[\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"/_next/static