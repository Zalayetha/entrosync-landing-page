er border-base-300 bg-base-100\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"collapse-title text-lg font-semibold\",\"children\":\"Is the client portal secure and read-only?\"}],[\"$\",\"div\",null,{\"className\":\"collapse-content leading-7 text-base-content/70\",\"children\":[\"$\",\"p\",null,{\"children\":\"Yes! The client portal is strictly read-only by design. Clients can view project progress, milestones, tasks, documents, logs, and invoices, but cannot alter project data or access freelancer settings.\"}]}]]}],[\"$\",\"details\",\"How does the Smart AI Brief feature work?\",{\"className\":\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"collapse-title text-lg font-semibold\",\"children\":\"How does the Smart AI Brief feature work?\"}],[\"$\",\"div\",null,{\"className\":\"collapse-content leading-7 text-base-content/70\",\"children\":[\"$\",\"p\",null,{\"children\":\"Simply paste raw client chat history, emails, or call notes into EntroSync. The AI analyzes the text to generate a structured PRD, scope of work, and recommended milestones that you can adopt with one click.\"}]}]]}],[\"$\",\"details\",\"Can freelancers issue invoices and export PDFs?\",{\"className\":\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"collapse-title text-lg font-semibold\",\"children\":\"Can freelancers issue invoices and export PDFs?\"}],[\"$\",\"div\",null,{\"className\":\"collapse-content leading-7 text-base-content/70\",\"children\":[\"$\",\"p\",null,{\"children\":\"Yes. You can generate professional invoices based on completed milestones or custom items, track status (Pending / Paid), and let clients view or download PDF invoices directly inside their portal.\"}]}]]}],[\"$\",\"details\",\"Can I manage multiple client projects at once?\",{\"className\":\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"collapse-title text-lg font-semibold\",\"children\":\"Can I manage multiple client projects at once?\"}],[\"$\",\"div\",null,{\"className\":\"collapse-content leading-7 text-base-content/70\",\"children\":[\"$\",\"p\",null,{\"children\":\"Absolutely. Freelancers have a centralized dashboard to manage all projects, track pending payouts across clients, and issue magic links for each active account.\"}]}]]}]]}]]}]\nd:[\"$\",\"footer\",null,{\"className\":\"border-t border-base-300 bg-base-100 py-12 text-base-content/80\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid gap-8 sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-3 lg:col-span-1\",\"children\":[[\"$\",\"a\",null,{\"className\":\"flex items-center gap-2\",\"href\":\"/en\",\"aria-label\":\"EntroSync Home\",\"children\":[[\"$\",\"$L2\",null,{\"alt\":\"EntroSync logo\",\"height\":28,\"src\":\"/favicon.svg\",\"width\":28}],[\"$\",\"span\",null,{\"className\":\"text-xl font-bold text-base-content\",\"children\":\"EntroSync\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs leading-relaxed text-base-content/60\",\"children\":\"The all-in-one client portal for freelancers & agencies. Convert raw chats to AI briefs, share magic links, and issue 1-click invoices.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-base-content\",\"children\":\"Product Features\"}],[\"$\",\"ul\",null,{\"className\":\"mt-3 space-y-2 text-xs\",\"children\":[[\"$\",\"li\",\"Smart AI Briefs\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#solutions\",\"className\":\"hover:text-primary transition\",\"children\":\"Smart AI Briefs\"}]}],[\"$\",\"li\",\"Magic Link Client Portal\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#playground\",\"className\":\"hover:text-p