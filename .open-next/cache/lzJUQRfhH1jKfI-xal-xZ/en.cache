{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/en/layout,_N_T_/en/page,_N_T_/en"},"segmentPaths":["/_tree","/_full","/en/__PAGE__","/en","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"id\" data-theme=\"entrosync\" class=\"inter_fe8b9d92-module__LINzvG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/favicon.svg\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/44pxtcnw1spdy.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1bofez1h07ns8.js\"/><script src=\"/_next/static/chunks/3onx57x5q00_y.js\" async=\"\"></script><script src=\"/_next/static/chunks/1m4y8hvx1de05.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-339zh2vhdk86u.js\" async=\"\"></script><script src=\"/_next/static/chunks/0pr6g23k3kqn-.js\" async=\"\"></script><script src=\"/_next/static/chunks/3krum7tl491tk.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ehwvjh3sx43.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>EntroSync | Client Portal for Freelancers and Agencies</title><meta name=\"description\" content=\"EntroSync helps freelancers and agencies turn client chats into AI briefs, milestones, zero-login client portals, and invoices in one workspace.\"/><link rel=\"canonical\" href=\"/en\"/><link rel=\"alternate\" hrefLang=\"id-ID\" href=\"/\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"/en\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-inter bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-base-100 text-base-content\"><header class=\"sticky top-0 z-50 border-b border-base-300 bg-base-100/95 backdrop-blur\"><nav class=\"navbar mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"navbar-start\"><div class=\"dropdown\"><button aria-label=\"Open navigation menu\" class=\"btn btn-ghost btn-square lg:hidden\" tabindex=\"0\" type=\"button\"><svg aria-hidden=\"true\" class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 6h16M4 12h16M4 18h16\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg></button><ul class=\"menu dropdown-content menu-sm z-50 mt-3 w-52 rounded-lg border border-base-300 bg-base-100 p-2 shadow\" tabindex=\"0\"><li><a href=\"#solutions\">Solutions</a></li><li><a href=\"#playground\">Playground</a></li><li><a href=\"#demo\">Demo</a></li><li><a href=\"#proof\">Proof</a></li><li><a href=\"#faq\">FAQ</a></li></ul></div><a class=\"flex items-center gap-2\" href=\"/en\" aria-label=\"EntroSync home\"><img alt=\"EntroSync logo\" width=\"32\" height=\"32\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/favicon.svg\"/><span class=\"text-xl font-bold\">EntroSync</span></a></div><div class=\"navbar-center hidden lg:flex\"><ul class=\"menu menu-horizontal gap-1 px-1\"><li><a href=\"#solutions\">Solutions</a></li><li><a href=\"#playground\">Playground</a></li><li><a href=\"#demo\">Demo</a></li><li><a href=\"#proof\">Proof</a></li><li><a href=\"#faq\">FAQ</a></li></ul></div><div class=\"navbar-end gap-2\"><div aria-label=\"Switch language\" class=\"join border border-base-300 bg-base-200 p-0.5\" role=\"group\"><button aria-pressed=\"false\" class=\"btn join-item btn-xs rounded-full px-3 btn-ghost\" type=\"button\">ID</button><button aria-pressed=\"true\" class=\"btn join-item btn-xs rounded-full px-3 btn-primary\" type=\"button\">EN</button></div><a class=\"btn btn-ghost hidden rounded-full sm:inline-flex\" href=\"#demo\">View demo</a><a class=\"btn btn-primary rounded-full\" href=\"#cta\">Get EntroSync</a></div></nav></header><section class=\"relative overflow-hidden border-b border-base-300 bg-base-100\"><div class=\"mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_0.95fr] lg:px-8 lg:py-24\"><div class=\"flex flex-col justify-center\"><div class=\"badge badge-outline mb-6 gap-2 border-primary/40 px-4 py-3 text-primary\">EntroSync - Freelancer &amp; Agency Client Portal</div><h1 class=\"max-w-3xl text-4xl font-bold leading-tight tracking-normal sm:text-5xl lg:text-6xl\">The all-in-one client portal for freelancers &amp; agencies.</h1><p class=\"mt-6 max-w-2xl text-lg leading-8 text-base-content/70\">Transform messy client chats into AI proposals, share zero-login magic links, track milestone progress in real time, and issue invoices in one calm workspace.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"btn btn-primary rounded-full px-7\" href=\"#cta\">Get EntroSync</a><a class=\"btn btn-outline rounded-full px-7\" href=\"#demo\">View demo</a></div><div class=\"mt-8 grid max-w-xl grid-cols-1 gap-3 text-sm sm:grid-cols-3\"><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">✨ Smart AI Briefs</div><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">🔗 0-Login Magic Links</div><div class=\"rounded-lg border border-base-300 bg-base-100 p-3 font-medium text-base-content/80\">⚡ 1-Click Invoices</div></div></div><div class=\"rounded-xl border border-base-300 bg-base-100 p-4 shadow-xl\"><div class=\"mb-4 flex items-center justify-between gap-3 border-b border-base-300 pb-4\"><div><p class=\"text-sm font-semibold\">Studio Ops Automation</p><p class=\"text-xs text-base-content/60\">Client Portal: /client/47b5f060...</p></div><span class=\"badge badge-success badge-outline whitespace-nowrap\">In Progress</span></div><div class=\"grid gap-3 sm:grid-cols-3\"><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Project Progress</p><p class=\"mt-2 text-lg font-bold\">64%</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Milestones</p><p class=\"mt-2 text-lg font-bold\">2 of 3 Done</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xs text-base-content/60\">Client Portal Link</p><p class=\"mt-2 text-lg font-bold\">Active</p></div></div><div class=\"mt-4 space-y-3\"><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Discovery &amp; Scope Confirmation</p><p class=\"text-sm text-base-content/60\">1 August 2026</p></div><span class=\"badge whitespace-nowrap badge-success\">Done</span></div><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Design Systems &amp; Wireframes</p><p class=\"text-sm text-base-content/60\">15 August 2026</p></div><span class=\"badge whitespace-nowrap badge-primary\">In Progress</span></div><div class=\"flex flex-col gap-3 rounded-lg border border-base-300 p-4 sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium\">Backend &amp; Client Portal Integration</p><p class=\"text-sm text-base-content/60\">4 September 2026</p></div><span class=\"badge whitespace-nowrap badge-neutral\">Not Started</span></div></div></div></div></section><section id=\"playground\" class=\"border-b border-base-300 bg-base-100 py-20\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"text-center\"><div class=\"badge badge-primary badge-outline mb-4 px-4 py-3\">Interactive Playground</div><h2 class=\"text-3xl font-bold sm:text-4xl\">Test the EntroSync workflow live.</h2><p class=\"mx-auto mt-3 max-w-2xl text-base-content/70\">See how AI transforms raw client chats into structured milestones, or preview what clients see when accessing their zero-login magic portal.</p></div><div class=\"mt-10 flex justify-center\"><div class=\"inline-flex max-w-full flex-col gap-1.5 rounded-3xl border border-base-300 bg-base-200 p-1.5 shadow-sm sm:flex-row sm:rounded-full\"><button class=\"flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition bg-primary text-primary-content shadow\" type=\"button\"><span>✨</span><span>1. Smart AI Brief Generator</span></button><button class=\"flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition text-base-content/70 hover:text-base-content\" type=\"button\"><span>🔗</span><span>2. Client Magic Portal (/client/:token)</span></button></div></div><div class=\"mt-10 grid gap-8 lg:grid-cols-2\"><div class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-md\"><div><div class=\"mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\"><span class=\"text-xs font-semibold uppercase tracking-wider text-base-content/60\">Raw Client Chat / Email Input</span><div class=\"flex gap-2\"><button class=\"btn btn-xs rounded-full btn-primary\" type=\"button\">Sample<!-- --> <!-- -->1</button><button class=\"btn btn-xs rounded-full btn-ghost\" type=\"button\">Sample<!-- --> <!-- -->2</button></div></div><textarea class=\"textarea textarea-bordered h-44 w-full bg-base-200 font-mono text-sm leading-relaxed text-base-content focus:outline-none\" placeholder=\"Paste WhatsApp chat history, email notes, or call transcripts here...\">Client: &quot;Hey! We need a full rebrand for our online store. New logo, homepage redesign, product filter fix, and payment gateway integration. Target launch is Sept 1st. Budget around $4k.&quot;</textarea></div><div class=\"mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\"><span class=\"text-xs text-base-content/60\">Using sample: E-Commerce Rebrand Chat</span><button class=\"btn btn-primary rounded-full px-6\" type=\"button\">✨ Generate AI SOW &amp; Milestones</button></div></div><div class=\"rounded-xl border border-base-300 bg-base-200 p-6 shadow-md\"><div class=\"mb-4 flex flex-col gap-2 border-b border-base-300 pb-3 sm:flex-row sm:items-center sm:justify-between\"><div class=\"flex items-center gap-2\"><span class=\"badge badge-success badge-xs\"></span><span class=\"text-xs font-semibold uppercase tracking-wider text-base-content/70\">Generated PRD &amp; Scope of Work</span></div><span class=\"badge badge-outline text-xs\">1-Click Adoption Ready</span></div><div class=\"space-y-4\"><div><h4 class=\"text-lg font-bold text-primary\">E-Commerce Store Rebrand &amp; Optimization</h4><p class=\"mt-1 text-xs leading-relaxed text-base-content/70\">Comprehensive visual rebrand, UI/UX redesign of homepage, catalog filtering fix, and Stripe payment gateway setup.</p></div><div class=\"space-y-2.5\"><p class=\"text-xs font-semibold text-base-content/60\">Extracted Milestones:</p><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">Brand Identity &amp; Design System</p><p class=\"text-xs text-base-content/60\">4<!-- --> <!-- -->tasks<!-- --> • <!-- -->Target:<!-- --> <!-- -->10 Aug 2026</p></div><span class=\"badge badge-sm badge-success\">Done</span></div><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">Homepage UI &amp; Product Filter Engine</p><p class=\"text-xs text-base-content/60\">6<!-- --> <!-- -->tasks<!-- --> • <!-- -->Target:<!-- --> <!-- -->22 Aug 2026</p></div><span class=\"badge badge-sm badge-primary\">In Progress</span></div><div class=\"flex flex-col gap-2 rounded-lg border border-base-300 bg-base-100 p-3 text-sm sm:flex-row sm:items-center sm:justify-between\"><div><p class=\"font-medium text-base-content\">Stripe Gateway &amp; Final QA Launch</p><p class=\"text-xs text-base-content/60\">3<!-- --> <!-- -->tasks<!-- --> • <!-- -->Target:<!-- --> <!-- -->1 Sep 2026</p></div><span class=\"badge badge-sm badge-neutral\">Not Started</span></div></div><div class=\"mt-4 flex justify-end\"><button class=\"btn btn-outline btn-sm rounded-full\" type=\"button\">🔗 Preview Client Magic Portal</button></div></div></div></div></div></section><section id=\"solutions\" class=\"mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"max-w-2xl\"><p class=\"font-semibold text-primary\">Core Platform Features</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Everything freelancers need to manage client work with total clarity.</h2><p class=\"mt-4 text-base-content/70\">Eliminate communication friction, save hours on project administration, and give clients a transparent view of progress.</p></div><div class=\"mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4\"><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">✨</div><h3 class=\"text-xl font-semibold\">Smart AI Brief Generator</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Paste raw WhatsApp chats, email threads, or call notes. AI instantly generates a structured PRD, scope of work, and 1-click project milestones.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">🔗</div><h3 class=\"text-xl font-semibold\">Zero-Login Client Portal</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Share a unique magic link (/client/:token). Clients gain instant read-only visibility into progress, documents, and invoices with zero account friction.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">📊</div><h3 class=\"text-xl font-semibold\">Transparent Progress Tracker</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Break projects into clear milestones. As you mark work done, the client progress bar updates live, eliminating repetitive &#x27;Where are we?&#x27; messages.</p></div></article><article class=\"flex flex-col justify-between rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:border-primary/40\"><div><div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-base-200 text-xl font-bold\">⚡</div><h3 class=\"text-xl font-semibold\">1-Click Invoices &amp; PDF Export</h3><p class=\"mt-3 text-sm leading-6 text-base-content/70\">Issue professional invoices directly from completed milestones. Clients can check payment status and download PDF invoices straight from their portal.</p></div></article></div></section><section id=\"demo\" class=\"border-y border-base-300 bg-base-100 py-20\"><div class=\"mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:px-8\"><div class=\"flex flex-col justify-center\"><p class=\"font-semibold text-primary\">Product Showcase</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">See work health before it becomes a meeting.</h2><p class=\"mt-4 leading-7 text-base-content/70\">Watch how EntroSync unifies client projects, milestones, client magic link access, and real-time invoicing in one seamless workspace.</p><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"badge badge-lg\">Dashboard</span><span class=\"badge badge-lg\">Client Portal</span><span class=\"badge badge-lg\">Milestones</span><span class=\"badge badge-lg\">Invoices</span></div></div><div class=\"overflow-hidden rounded-xl border border-base-300 bg-base-200 shadow-2xl\"><div class=\"flex items-center justify-between border-b border-base-300 bg-base-300/40 px-4 py-3\"><div class=\"flex items-center gap-2\"><span class=\"inline-block h-3 w-3 rounded-full bg-red-500/80\"></span><span class=\"inline-block h-3 w-3 rounded-full bg-yellow-500/80\"></span><span class=\"inline-block h-3 w-3 rounded-full bg-green-500/80\"></span></div><span class=\"text-xs font-medium text-base-content/60\">EntroSync - Product Demo Walkthrough</span><div class=\"w-12\"></div></div><div class=\"relative aspect-video w-full bg-black\"><video autoPlay=\"\" controls=\"\" loop=\"\" muted=\"\" playsInline=\"\" preload=\"metadata\" class=\"h-full w-full object-cover\" src=\"/product-demo.mp4\"><track kind=\"captions\"/>Your browser does not support the video tag.</video></div></div></div></section><section id=\"proof\" class=\"mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"grid gap-8 lg:grid-cols-[0.75fr_1fr]\"><div><p class=\"font-semibold text-primary\">Freelancer Approved</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Built for high-trust client relationships.</h2><div class=\"mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3\"><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">100%</p><p class=\"mt-1 text-xs text-base-content/60\">Read-Only Security</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">1-Click</p><p class=\"mt-1 text-xs text-base-content/60\">Magic Invites</p></div><div class=\"rounded-lg bg-base-200 p-4\"><p class=\"text-xl font-bold\">10x</p><p class=\"mt-1 text-xs text-base-content/60\">Faster Proposals</p></div></div></div><div class=\"grid gap-4 md:grid-cols-3\"><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->EntroSync saved me 5+ hours every week on admin. My clients love opening one magic link instead of asking me for manual updates.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Alex Rivera</p><p class=\"text-xs text-base-content/60\">Full-Stack Freelancer</p></div></article><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->The AI Brief feature is magic. I paste a 100-line client WhatsApp thread, and EntroSync gives me a full PRD and milestones in seconds.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Maya Chen</p><p class=\"text-xs text-base-content/60\">Design Systems Consultant</p></div></article><article class=\"flex flex-col justify-between rounded-lg border border-base-300 p-5\"><p class=\"text-sm leading-6 text-base-content/80\">“<!-- -->Invoicing used to be a hassle. Now my clients view and download PDF invoices directly inside their token-scoped portal when milestones wrap up.<!-- -->”</p><div class=\"mt-5 border-t border-base-300/50 pt-3\"><p class=\"text-sm font-semibold\">Marcus Vance</p><p class=\"text-xs text-base-content/60\">Agency Founder</p></div></article></div></div></section><section id=\"why-us\" class=\"border-y border-base-300 bg-base-100 py-20\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><p class=\"font-semibold text-primary\">Why EntroSync?</p><h2 class=\"mt-3 max-w-2xl text-3xl font-bold sm:text-4xl\">Replace scattered client chaos with structured workspace clarity.</h2><div class=\"mt-10 overflow-hidden rounded-xl border border-base-300 bg-base-100 shadow-sm\"><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Scattered Workflow</p><p class=\"mt-1 text-sm font-medium\">Scattered WhatsApp chats, Drive links &amp; Notion docs</p></div><div><p class=\"text-sm font-semibold text-primary\">EntroSync Workspace</p><p class=\"mt-1 text-sm font-medium\">Single unified workspace for freelancer &amp; client</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Before</p><p class=\"mt-1 text-sm font-medium\">Manual SOW &amp; proposal creation from scratch</p></div><div><p class=\"text-sm font-semibold text-primary\">After</p><p class=\"mt-1 text-sm font-medium\">AI-generated PRDs, scope of work &amp; 1-click milestones</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Before</p><p class=\"mt-1 text-sm font-medium\">Constant &#x27;Where are we?&#x27; client status check-ins</p></div><div><p class=\"text-sm font-semibold text-primary\">After</p><p class=\"mt-1 text-sm font-medium\">Real-time read-only progress bars &amp; milestone tracking</p></div></div><div class=\"grid gap-4 border-b border-base-300 p-5 last:border-b-0 md:grid-cols-2\"><div><p class=\"text-sm font-semibold text-red-400/80\">Before</p><p class=\"mt-1 text-sm font-medium\">Separate Excel invoicing &amp; PDF attachments</p></div><div><p class=\"text-sm font-semibold text-primary\">After</p><p class=\"mt-1 text-sm font-medium\">Integrated 1-click invoicing with live payment status &amp; PDF export</p></div></div></div></div></section><section id=\"cta\" class=\"mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8\"><div class=\"rounded-xl bg-neutral p-6 text-neutral-content shadow-xl sm:p-10\"><div class=\"grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center\"><div><p class=\"font-semibold text-neutral-content/80\">Early Access</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Upgrade your client portal experience today.</h2><p class=\"mt-4 leading-7 text-neutral-content/70\">Join the EntroSync waitlist to streamline client briefs, milestone tracking, and invoicing in one workspace.</p></div><form class=\"flex flex-col gap-3\" action=\"#\"><label class=\"sr-only\" for=\"email\">Email address</label><input class=\"input input-bordered w-full bg-base-100 text-base-content\" id=\"email\" placeholder=\"freelancer@agency.com\" type=\"email\" name=\"email\"/><button class=\"btn btn-primary rounded-full\" type=\"submit\">Get EntroSync</button><p class=\"text-xs text-neutral-content/60\">Zero spam. Be first to access EntroSync.</p></form></div></div></section><section id=\"faq\" class=\"mx-auto max-w-4xl px-4 pb-20 sm:px-6 lg:px-8\"><div class=\"text-center\"><p class=\"font-semibold text-primary\">Frequently Asked Questions</p><h2 class=\"mt-3 text-3xl font-bold sm:text-4xl\">Everything you need to know about EntroSync.</h2></div><div class=\"mt-10 space-y-3\"><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">How do clients access their project portal?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Freelancers generate a unique magic link (e.g. /client/:token) for each project. Clients open the link directly on desktop or mobile without needing to register, log in, or remember a password.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Is the client portal secure and read-only?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Yes! The client portal is strictly read-only by design. Clients can view project progress, milestones, tasks, documents, logs, and invoices, but cannot alter project data or access freelancer settings.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">How does the Smart AI Brief feature work?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Simply paste raw client chat history, emails, or call notes into EntroSync. The AI analyzes the text to generate a structured PRD, scope of work, and recommended milestones that you can adopt with one click.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Can freelancers issue invoices and export PDFs?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Yes. You can generate professional invoices based on completed milestones or custom items, track status (Pending / Paid), and let clients view or download PDF invoices directly inside their portal.</p></div></details><details class=\"collapse collapse-arrow rounded-lg border border-base-300 bg-base-100\"><summary class=\"collapse-title text-lg font-semibold\">Can I manage multiple client projects at once?</summary><div class=\"collapse-content leading-7 text-base-content/70\"><p>Absolutely. Freelancers have a centralized dashboard to manage all projects, track pending payouts across clients, and issue magic links for each active account.</p></div></details></div></section><footer class=\"border-t border-base-300 bg-base-100 py-12 text-base-content/80\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\"><div class=\"grid gap-8 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"space-y-3 lg:col-span-1\"><a class=\"flex items-center gap-2\" href=\"/en\" aria-label=\"EntroSync Home\"><img alt=\"EntroSync logo\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/favicon.svg\"/><span class=\"text-xl font-bold text-base-content\">EntroSync</span></a><p class=\"text-xs leading-relaxed text-base-content/60\">The all-in-one client portal for freelancers &amp; agencies. Convert raw chats to AI briefs, share magic links, and issue 1-click invoices.</p></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Product Features</p><ul class=\"mt-3 space-y-2 text-xs\"><li><a href=\"#solutions\" class=\"hover:text-primary transition\">Smart AI Briefs</a></li><li><a href=\"#playground\" class=\"hover:text-primary transition\">Magic Link Client Portal</a></li><li><a href=\"#demo\" class=\"hover:text-primary transition\">Product Video Demo</a></li><li><a href=\"#solutions\" class=\"hover:text-primary transition\">1-Click Invoicing &amp; PDF Export</a></li></ul></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Navigation</p><ul class=\"mt-3 space-y-2 text-xs\"><li><a href=\"#why-us\" class=\"hover:text-primary transition\">Why EntroSync?</a></li><li><a href=\"#proof\" class=\"hover:text-primary transition\">Freelancer Proof &amp; Reviews</a></li><li><a href=\"#faq\" class=\"hover:text-primary transition\">Frequently Asked Questions</a></li><li><a href=\"#cta\" class=\"hover:text-primary transition\">Early Access Waitlist</a></li></ul></div><div><p class=\"text-xs font-semibold uppercase tracking-wider text-base-content\">Client Portal Security</p><div class=\"mt-3 rounded-lg border border-base-300 bg-base-200 p-3 text-xs text-base-content/70\"><p class=\"font-semibold text-primary\">100% Read-Only Isolation</p><p class=\"mt-1 text-[11px] leading-relaxed\">Token-scoped client access (`/client/:token`) ensures clients can monitor project progress safely without altering workspace data.</p></div></div></div><div class=\"mt-12 flex flex-col items-center justify-between border-t border-base-300/60 pt-6 text-xs text-base-content/50 sm:flex-row\"><p>© <!-- -->2026<!-- --> EntroSync. <!-- -->All rights reserved.</p><div class=\"mt-3 flex gap-4 sm:mt-0\"><a href=\"#\" class=\"hover:text-base-content transition\">Privacy Policy</a><a href=\"#\" class=\"hover:text-base-content transition\">Terms of Service</a><a href=\"#\" class=\"hover:text-base-content transition\">Security Rules</a></div></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/1bofez1h07ns8.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[29113,[\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"/_next/static/chunks/3krum7tl491tk.js\\\"],\\\"default\\\"]\\n3:I[55881,[\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"/_next/static/chunks/3krum7tl491tk.js\\\"],\\\"default\\\"]\\n4:I[38988,[\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"/_next/static/chunks/3krum7tl491tk.js\\\",\\\"/_next/static/chunks/08ehwvjh3sx43.js\\\"],\\\"Image\\\"]\\n15:I[20708,[\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"/_next/static/chunks/3krum7tl491tk.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/44pxtcnw1spdy.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"en\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"en\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/44pxtcnw1spdy.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/0pr6g23k3kqn-.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-1\\\",{\\\"src\\\":\\\"/_next/static/chunks/3krum7tl491tk.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",nu